[Unit]
Description=vpnctl backup snapshot timer (daily 03:00 UTC)
Documentation=https://github.com/PavelLizunov/vpnctl

[Timer]
# 03:00 UTC daily — minimal traffic on the homelab, nightly window
# coincides with no human activity.
OnCalendar=*-*-* 03:00:00
# Persistent: if the host was off when the timer would have fired,
# run on next boot. Backups should NEVER be silently skipped.
Persistent=true
# Add a small randomized delay to avoid every server in a hypothetical
# fleet hitting 207 at the exact same second.
RandomizedDelaySec=300
Unit=vpnctl-backup.service

[Install]
WantedBy=timers.target
