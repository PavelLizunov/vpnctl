[Unit]
Description=vpnctl GeoIP DB refresh (DB-IP Lite, monthly)
Documentation=https://github.com/PavelLizunov/vpnctl
# Don't fire while vpnctld is being restarted itself — they share
# the geoip dir; the atomic-rename in `vpnctl geoip-update` is safe
# even if vpnctld is reading the old mmap (`mmap` survives an
# inode-replacement) but the start order is still cleaner with the
# After= directive. NOTE: `After=` orders STARTUP only — once both
# are running, this oneshot can fire while vpnctld is alive; the
# atomic-rename is what makes that safe.
After=vpnctld.service
# Network needed for the DB-IP download (~140 MB total).
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Same user/group as the daemon — owns /var/lib/vpnctl/geoip.
User=user
Group=user
# Reads VPNCTLD_GEOIP_DIR. Empty default = /var/lib/vpnctl/geoip
# (resolved inside the fetch script + `cli/src/cmd/geoip.rs`).
EnvironmentFile=-/etc/vpnctl/vpnctld.env
# ssh (spawned by the fetch script) looks under $HOME/.ssh; the daemon
# user's real home (/home/user) is blocked by ProtectHome=true, so point
# HOME at the vpnctl state dir where the deploy key already lives.
Environment=HOME=/var/lib/vpnctl
# Node-proxied fetch (see the script header): 192.168.0.236 can't
# complete downloads from db-ip's Cloudflare CDN, so the DBs are pulled
# THROUGH a VPN node via the deploy key. Replaces the direct
# `/usr/local/bin/vpnctl geoip-update`, which times out every month on
# this host. The script does the same decompress→validate→atomic-rename.
ExecStart=/usr/local/bin/vpnctl-geoip-fetch-via-node.sh
# Total budget: download + decompress + validate two .mmdb files
# (~150 MB combined). 10 minutes is generous; on a flaky network
# DB-IP can be slow but rarely 600s+.
TimeoutStartSec=600
# Don't restart automatically on failure — the next monthly tick
# (or the operator clicking the Settings button) is the recovery
# path. systemd-journal will surface the error.
Restart=no

# ── Sandbox / hardening ────────────────────────────────────────────
# Mirrors scripts/vpnctld.service posture (audited 2026-05-18). This
# oneshot is even more constrained than the daemon: it only needs
# outbound HTTPS, read of vpnctld.env, and write of one directory.

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/vpnctl/geoip
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectClock=true
ProtectControlGroups=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
UMask=0077

# Caps: oneshot CLI never needs root capabilities. Drop them all.
CapabilityBoundingSet=
AmbientCapabilities=

# Syscall filter — `@system-service` is the maintained allowlist for
# normal long-running services; identical exclusions to vpnctld.
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @obsolete @raw-io @reboot @swap @debug @cpu-emulation @mount
SystemCallArchitectures=native
SystemCallErrorNumber=EPERM

# Address families — IPv4/IPv6 outbound + unix sockets. The DB-IP
# fetch is plain HTTPS, no AF_NETLINK / AF_PACKET / AF_BLUETOOTH.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

# Resource ceilings (low-effort DoS defense).
TasksMax=64
LimitNOFILE=1024

[Install]
WantedBy=multi-user.target
