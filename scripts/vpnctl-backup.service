[Unit]
Description=vpnctl daily encrypted backup snapshot
Documentation=https://github.com/PavelLizunov/vpnctl
# Don't fight with vpnctld restarts during backup — sqlite3 .backup
# uses the WAL backup API which tolerates a running daemon, but
# strict ordering is cleaner.
After=vpnctld.service

[Service]
Type=oneshot
User=user
Group=user
# Reads VPNCTLD_* (e.g. VPNCTLD_DEPLOY_KEY). Optional if file doesn't exist yet.
EnvironmentFile=-/etc/vpnctl/vpnctld.env
# The script is read-only on the production state EXCEPT the durable
# backup dir: it snapshots → archives → age-encrypts → writes the final
# .tar.zst.age to /var/lib/vpnctl/backups (BACKUP_DIR) → scp off-host.
# So it needs write access to /tmp (scratch staging) AND the exact
# backups dir, and read access to /var/lib/vpnctl, /etc/vpnctl,
# /opt/vpnctl/assets.
ExecStart=/usr/local/bin/vpnctl-backup.sh
# Hardening: minimal capabilities. The script runs sqlite3 + tar + zstd
# + age + scp; none need elevated privileges if the inv.db is readable
# by `user` (which it is — see /var/lib/vpnctl perms in CLAUDE.md).
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
# /tmp = scratch staging (wiped by the script's EXIT trap).
# /var/lib/vpnctl/backups = the DURABLE deliverable dir: the encrypted
#   bundle is written HERE and must survive an scp failure for manual
#   recovery. This more-specific path wins over ReadOnlyPaths=/var/lib/vpnctl
#   below, so ONLY backups/ is writable — inv.db and the rest of
#   /var/lib/vpnctl stay read-only. (The dir is created at install time;
#   mkdir -p on an existing dir needs no write on the read-only parent.)
ReadWritePaths=/tmp /var/lib/vpnctl/backups
ReadOnlyPaths=/var/lib/vpnctl /etc/vpnctl /opt/vpnctl
PrivateTmp=true
# Surface failures to journalctl with a reasonable timeout.
TimeoutStartSec=300
StandardOutput=journal
StandardError=journal
