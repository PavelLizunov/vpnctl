[Unit]
Description=vpnctl kernel-update timer (daily 00:30 UTC / 03:30 MSK)
Documentation=https://github.com/PavelLizunov/vpnctl

[Timer]
# Every night at 03:30 MSK, after vpnctl-backup.timer's 03:00 MSK window.
# The CLI walks servers and each server's declared kernels sequentially.
OnCalendar=*-*-* 00:30:00 UTC
# Persistent: if the host was off at night, run once after the next boot.
Persistent=true
# Spread the actual start across 03:30–03:40 MSK.
RandomizedDelaySec=600
Unit=vpnctl-update-kernels.service

[Install]
WantedBy=timers.target
