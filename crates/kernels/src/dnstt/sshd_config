AddressFamily inet
ListenAddress 127.0.0.1:22054
HostKey /etc/vpnctl-dnstt/ssh_host_ed25519_key
PidFile /run/vpnctl-dnstt-ssh/sshd.pid
UsePAM yes
AllowUsers vpnctldnstt
PermitRootLogin no
PubkeyAuthentication yes
AuthenticationMethods publickey
PasswordAuthentication no
KbdInteractiveAuthentication no
AuthorizedKeysFile /etc/vpnctl-dnstt/authorized_keys
AllowTcpForwarding local
AllowStreamLocalForwarding no
AllowAgentForwarding no
X11Forwarding no
PermitTunnel no
PermitTTY no
PermitUserRC no
GatewayPorts no
MaxSessions 0
MaxStartups 5:30:10
LoginGraceTime 20
