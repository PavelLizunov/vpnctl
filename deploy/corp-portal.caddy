# Replace the four __CORP_*__ placeholders, then import this site exactly once
# from the parent Caddyfile. Do not paste it inline or nest another import.
# __CORP_ASSETS__ contains corp.css, corp.js, corp-phone.js and corp-diagnostics.js.
# The private __CORP_SERVICE_HEADER__ file contains only:
# header_up Authorization "Bearer <private service capability>"
# Requires Caddy >= 2.11 (request_body set). Keep the header file private.
admin.corp.ninitux.com {
	@corpAssets {
		method GET HEAD
		path /assets/corp.css /assets/corp.js /assets/corp-phone.js /assets/corp-diagnostics.js
	}
	handle @corpAssets {
		root * __CORP_ASSETS__
		uri strip_prefix /assets
		header Cache-Control no-store
		header X-Content-Type-Options nosniff
		file_server
	}

	@corpDelete {
		method DELETE
		path_regexp corpReport ^/api/corp/reports/([0-9a-f]{64})$
		expression `{http.request.uri.query} == ""`
	}
	handle @corpDelete {
		route {
			# set replaces the original body before max_size is applied.
			# Reject unknown/chunked lengths and anything above 1024 bytes first.
			@unboundedDeleteBody not header_regexp Content-Length ^([0-9]{1,3}|10[01][0-9]|102[0-4])$
			respond @unboundedDeleteBody "A body of at most 1024 bytes with Content-Length is required." 413
			# Import consumes one escape layer; request_body consumes the next.
			# Both fixed JSON bodies below need two backslashes before each brace.
			request_body {
				max_size 1KB
				set `\\{"site":"example.com"\\}`
			}
			reverse_proxy __CORP_BACKEND__ {
				method POST
				rewrite /api/corp/normalize
				header_up Content-Type application/json
				header_up Host admin.corp.ninitux.com
				header_up X-Real-IP {http.request.remote.host}
				header_up X-Forwarded-Proto https
				header_up -Forwarded
				header_up -X-Forwarded-For
				header_up -X-Forwarded-Host
				header_up -X-Corp-Company
				@authorized status 200
				handle_response @authorized {
					vars corpServiceCompany {rp.header.X-Corp-Company}
					@missingDeleteCompany expression `{http.vars.corpServiceCompany} == ""`
					respond @missingDeleteCompany "Company context unavailable." 503
					request_body {
						set `\\{\\}`
					}
					reverse_proxy __CORP_RECEIVER__ {
						method DELETE
						rewrite /internal/corp-diagnostics/reports/{re.corpReport.1}
						# Drop every browser header, including Cookie, Origin,
						# X-Corp-CSRF and Authorization, before adding service identity.
						header_up -*
						header_up Host {upstream_hostport}
						header_up X-Corp-Company {http.vars.corpServiceCompany}
						header_up Content-Type application/json
						import __CORP_SERVICE_HEADER__
						header_down Cache-Control no-store
						header_down X-Content-Type-Options nosniff
					}
				}
			}
		}
	}
	@corpCategories {
		method POST
		path_regexp corpCategory ^/api/corp/categories/(state|save)$
		expression `{http.request.uri.query} == ""`
	}
	handle @corpCategories {
		route {
			@invalidCategoryBody {
				not header_regexp Content-Length ^[1-9][0-9]{0,5}$
			}
			respond @invalidCategoryBody "A bounded JSON body with Content-Length is required." 413
			@chunkedCategoryBody header Transfer-Encoding *
			respond @chunkedCategoryBody "Transfer-Encoding is not supported." 413
			request_body {
				max_size 256KB
			}
			vars corpMetadataLength {http.request.header.Content-Length}
			vars corpMetadataPath {http.request.uri.path}
			vars corpMetadataBody {http.request.body}
			request_body {
				set `\\{"site":"example.com"\\}`
			}
			reverse_proxy __CORP_BACKEND__ {
				method POST
				rewrite /api/corp/normalize
				header_up Content-Type application/json
				header_up Host admin.corp.ninitux.com
				header_up X-Real-IP {http.request.remote.host}
				header_up X-Forwarded-Proto https
				header_up -Forwarded
				header_up -X-Forwarded-For
				header_up -X-Forwarded-Host
				header_up -X-Corp-Company
				@categoryAuthorized status 200
				handle_response @categoryAuthorized {
					vars corpServiceCompany {rp.header.X-Corp-Company}
					@missingMetadataCompany expression `{http.vars.corpServiceCompany} == ""`
					respond @missingMetadataCompany "Company context unavailable." 503
					request_body {
						set {http.vars.corpMetadataBody}
					}
					rewrite * {http.vars.corpMetadataPath}
					uri replace /api/corp/categories/ /internal/corp-categories/
					reverse_proxy __CORP_RECEIVER__ {
						method POST
						header_up -*
						header_up Host {upstream_hostport}
						header_up X-Corp-Company {http.vars.corpServiceCompany}
						header_up Content-Type application/json
						header_up X-Corp-Expected-Length {http.vars.corpMetadataLength}
						import __CORP_SERVICE_HEADER__
						header_down Cache-Control no-store
						header_down X-Content-Type-Options nosniff
					}
				}
			}
		}
	}

	# All HTML, other API routes and other methods retain the existing backend.
	handle {
		reverse_proxy __CORP_BACKEND__ {
			header_up Host admin.corp.ninitux.com
			header_up X-Real-IP {http.request.remote.host}
			header_up X-Forwarded-Proto https
			header_up -Forwarded
			header_up -X-Forwarded-For
			header_up -X-Forwarded-Host
				header_up -X-Corp-Company
		}
	}
}
